# This is an example of your .env file format, which pnpm db:setup will create.
# Note: this must be .env, not .env.local, without further configuration changes.
# 注意：Vercel 的 Preview 环境同样需要配置该变量，否则 Preview 部署会在运行时失败。
POSTGRES_URL=postgresql://***
STRIPE_SECRET_KEY=sk_test_***
STRIPE_WEBHOOK_SECRET=whsec_***
# 站点基址（用于 Stripe 回跳与 OAuth redirect_uri）。
# 未配置时回退到 Vercel 注入的 VERCEL_URL，再回退到 localhost，因此 Preview 可不配。
BASE_URL=http://localhost:3000
AUTH_SECRET=***

# AI 能力（可选）。未配置 AI_API_KEY 时使用本地 Mock Provider 演示。
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_DEFAULT_MODEL=gpt-4o-mini
# 向量化检索模型（可选，用于客服知识库语义检索）
AI_EMBEDDING_MODEL=text-embedding-3-small

# 门店 / 小程序接入（可选）。本地商家默认走 miniprogram 占位适配器；
# Shopify 参考实现需要以下变量。
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_TEST_SHOP=example.myshopify.com

# 用量计费（可选）。超额 token 上报到 Stripe Billing Meter 的名称。
# 需先在 Stripe Dashboard 创建 billing meter 并配置价格。
STRIPE_OVERAGE_METER_NAME=

# 分布式限流（可选但生产强烈建议）。配置后登录/注册/AI 接口的限流在
# Vercel 多实例间共享；未配置时降级为单实例内存计数（多实例下会失效）。
# 两种来源任选其一，代码会依次读取：
#   1) 手工配置（Upstash 控制台）：
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
#   2) Vercel 的 Upstash 集成自动注入（变量名为 KV_ 前缀，无需手工填写）：
#      KV_REST_API_URL / KV_REST_API_TOKEN
# 安装命令：vercel integration add upstash/upstash-kv